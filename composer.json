{
  "name": "ashcoft/photo-editor",
  "description": "A Nextcloud app to edit photos and open PSD files in the browser",
  "license": "MIT",
  "authors": [
    {
      "name": "ashcoft",
      "email": "dony@dony.me",
      "homepage": "https://github.com/ashcoft/nextcloud-photo-editor"
    }
  ],
  "require": {
    "bamarni/composer-bin-plugin": "^1.8",
    "php": "^8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "nextcloud/coding-standard": "^1.5",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.5",
    "symfony/event-dispatcher": "^8.0",
    "symfony/finder": "^8.0",
    "symfony/options-resolver": "^8.0",
    "symfony/process": "^8.0",
    "symfony/stopwatch": "^8.0",
    "symfony/string": "^8.0",
    "vimeo/psalm": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "OCA\\PhotoEditor\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\PhotoEditor\\Tests\\": "tests/",
      "OCP\\": "vendor-bin/nextcloud-ocp/vendor/nextcloud/ocp/OCP/",
      "NCU\\": "vendor-bin/nextcloud-ocp/vendor/nextcloud/ocp/NCU/",
      "OC\\": "tests/stubs/OC/",
      "OC\\Hooks\\": "tests/stubs/OC/Hooks/"
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "forward-command": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@composer bin all install --ansi"
    ],
    "post-update-cmd": [
      "@composer bin all install --ansi"
    ],
    "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm --threads=1 --no-cache",
    "phpstan": "phpstan analyze --no-progress",
    "rector": "rector process",
    "test:unit": "phpunit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky --fail-on-deprecation --fail-on-notice",
    "openapi": "php -r 'echo \"No OpenAPI generation required - this app has no external API\\n\";' && exit 0"
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.3"
    }
  }
}
