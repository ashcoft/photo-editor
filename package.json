{
  "name": "nextcloud-photo-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Nextcloud app for photo editing and PSD viewing",
  "packageManager": "pnpm@10.34.9",
  "license": "MIT",
  "author": "Photo Editor Contributors",
  "repository": "https://github.com/ashcoft/photo-editor",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "lint": "eslint src/",
    "stylelint": "stylelint 'src/**/*.{vue,css}' 'css/**/*.css'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "check-types": "vue-tsc --noEmit",
    "commitlint": "commitlint --from origin/main --to HEAD"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/files": "^4.1.1",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.1.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vue/compiler-sfc": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^30.0.0",
    "babel-loader": "^10.0.0",
    "commitlint": "^21.0.0",
    "conventional-changelog-conventionalcommits": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-transform-stub": "^2.0.0",
    "postcss-html": "^2.0.0",
    "semantic-release": "^25.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "npm:typescript@^7.0.0",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^2.1.10",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^8.0.0"
    }
  }
}
