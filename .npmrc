# pnpm configuration
#
# The release-age guard is off, matching the reference app.
#
# pnpm's age check applies to resolution, not just installation, so a guard
# here blocks Renovate and Dependabot from regenerating pnpm-lock.yaml: both
# resolve the newest version of a dependency, pnpm refuses anything published
# in the last day, and the bot is left with a package.json that no longer
# matches the lockfile. CI then fails on `--frozen-lockfile`.
#
# The guard belongs where it does not break lockfile resolution, so it is set
# on the updaters instead: `minimumReleaseAge` in renovate.json and Dependabot's
# `cooldown`. Those hold a new version back before it is proposed at all, which
# is what the guard is for.
minimum-release-age=0
